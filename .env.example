# —— 全部可选。不配也能跑：配音自动回退免费 edge-tts，背景自动回退占位图 ——

# Azure 语音（配音音质更好）。留空则用 edge-tts 的 zh-CN-YunxiNeural
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia

# 图像生成（背景图）。留空则读 ~/.workbuddy/models.json
IMAGE2_API_KEY=
IMAGE2_BASE_URL=

# 交付目录。成片最终落到 $VIDEO_OUT_ROOT/$VIDEO_PROJECT_NAME/
VIDEO_OUT_ROOT=D:\AI视频
VIDEO_PROJECT_NAME=数据竞速

# 成片时长上限（秒）。软约束：超出会用更快语速重录配音，不截断内容
RACE_MAX_DUR=120

# 本机依赖（不配则自动探测）
# CHROME=C:\Program Files\Google\Chrome\Application\chrome.exe
# FFPROBE=C:\ProgramData\chocolatey\bin\ffprobe
